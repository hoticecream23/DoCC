__pycache__/
*.pyc
.pytest_cache/
# generated demo artifacts
corpus/
models/
results.jsonl
results.jsonl.bboxes/
annotations.jsonl
profile.md
report.md
comparison.md
scores.json
graph.json
graph.dot
graph.md
before.jsonl
gold.jsonl
tables.jsonl
tables.md

# Real client documents. Never commit these.
Client_Documents/
Classification_Doc/

# A second delivery of the same material, plus the review workbook. The two
# patterns above already match the copies nested inside it, but only because
# they carry no leading slash. Anything dropped directly into ML_Documents/
# would not be covered, and all of it is client material.
ML_Documents/

# Anything derived from them. A gold file built from Classification.csv carries
# client file names and paths in every row, so it is client material too.
gold_classification.jsonl
results_classification.jsonl
results_classification.jsonl.bboxes/
scores_classification.json
report_classification.md
labels.md

# A full run over Client_Documents. This one carries the extracted text of all
# 227 documents, not just their names, so it is the single largest piece of
# client material any command in this repo produces.
client_results.jsonl
client_results.jsonl.bboxes/
client_run.log

# Generated summary documents. Rebuild them rather than tracking the binary.
What_We_Built.pdf

# Review workbooks exported from a run. Every one carries client file names,
# text previews and extracted field values, so they are client material even
# though the pipeline generated them.
review*.xlsx
*_review.xlsx

# Gold imported from the reviewed workbook. Client file names in every row.
gold_reviewed.jsonl
gold_reviewed.md
# The name HANDOFF recommends for gold imported from the client review.
gold_client.jsonl
